# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEADS_TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# Google Sheets (service account mode)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
LEADS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Leads
GOOGLE_SHEETS_WIDGET_SHEET_NAME=WidgetLeads

# Google Sheets (key file mode for scripts/sheet-leads-to-telegram.mjs)
GOOGLE_SHEETS_KEY_FILE=
GOOGLE_SHEETS_ADS_SHEET_NAME=
SHEET_LEADS_SHEET_NAMES=Facebook_leads
SHEET_LEADS_STATE_FILE=
SHEET_LEADS_POLL_INTERVAL_MS=60000
SHEET_LEADS_FETCH_RETRIES=3
SHEET_LEADS_SEND_TEST_LEADS=0

# OpenClaw / Google MCP fallback paths
OPENCLAW_CONFIG_PATH=
GOOGLE_MCP_CLIENT_PATH=
GOOGLE_MCP_TOKEN_PATH=

# Site URL used by lead origin validation
NEXT_PUBLIC_SITE_URL=https://domarketing.ee
SITE_URL=https://domarketing.ee

# Confirmation email to the client (Zoho Mail SMTP)
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=587
SMTP_USER=ceo@domarketing.ee
SMTP_PASSWORD=
SMTP_FROM=Do.Marketing <ceo@domarketing.ee>

# Confirmation email to the client (Zoho Mail API, preferred)
# OAuth scopes: ZohoMail.messages.CREATE and ZohoMail.accounts.READ if account id is not set.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
ZOHO_MAIL_API_BASE=https://mail.zoho.eu/api
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_FROM_ADDRESS=ceo@domarketing.ee
